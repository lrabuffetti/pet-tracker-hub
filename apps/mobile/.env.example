# Physical device only (phone on the same Wi‑Fi as your Mac).
# Find your Mac IP: System Settings → Network, or run: ipconfig getifaddr en0
#
# Simulators ignore this file:
#   iOS Simulator     → http://localhost:3000
#   Android Emulator  → http://10.0.2.2:3000
# Physical device fallback (Metro auto-detects the Mac IP in dev).
EXPO_PUBLIC_API_URL=http://192.168.1.37:3000

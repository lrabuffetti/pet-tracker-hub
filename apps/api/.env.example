# MySQL connection string (from DBeaver: user, password, host, port, database)
# Example: mysql://root:password@localhost:3306/pet_tracker_hub
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
# Use onboarding@resend.dev for testing, or a verified address on your domain
EMAIL_FROM="onboarding@resend.dev"
APP_NAME="Pet Tracker Hub"

# JWT access tokens (short-lived; refresh tokens last 24h)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="24h"
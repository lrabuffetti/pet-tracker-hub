# MySQL connection string (from DBeaver: user, password, host, port, database)
# Example: mysql://root:password@localhost:3306/pet_tracker_hub
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
# Use onboarding@resend.dev for testing, or a verified address on your domain
EMAIL_FROM="onboarding@resend.dev"
APP_NAME="Pet Tracker Hub"

# JWT access tokens (short-lived; refresh tokens last 24h)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="24h"

# File storage: "local" for dev, "r2" for production (Railway)
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
LOCAL_UPLOAD_BASE_URL="http://localhost:3000/uploads"
API_BASE_URL="http://localhost:3000"

# Cloudflare R2 (when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pet-tracker-uploads"
R2_PUBLIC_BASE_URL=""

# Railway sets PORT automatically — do not hardcode in production.
# PORT=3000